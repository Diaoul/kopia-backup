#!/usr/bin/env bash
# Apply the global kopia policy.
#
# Usage: kopia-policy [excludes-file]
#
# Unlike restic, kopia takes no exclude or retention arguments per run: both
# live in policies stored inside the repository. Run this once after connecting,
# and again whenever the excludes change. Needs jq.
set -euo pipefail

config=${KOPIA_CONFIG:-/etc/kopia/repository.config}
log_dir=${KOPIA_LOG_DIR:-/var/log/kopia}
excludes=${1:-/etc/kopia/excludes}

kopia() { command kopia --config-file "$config" --log-dir "$log_dir" "$@"; }

if [[ ! -r $excludes ]]; then
    echo "no readable excludes file: $excludes" >&2
    exit 1
fi

# `|| [[ -n $line ]]` keeps the last line of a file that ends without a newline,
# which read would otherwise hand over and then report as end of input.
wanted=()
while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    wanted+=("$line")
done < "$excludes"

# An empty rule set would drop every ignore rule and leave nothing in their
# place, so every cache directory would land in the next snapshot.
if (( ${#wanted[@]} == 0 )); then
    echo "no ignore rules in $excludes" >&2
    exit 1
fi

# Reading the current rules doubles as the reachability check: it fails here,
# before anything has been modified, when the repository is out of reach.
mapfile -t current < <(kopia policy show --global --json | jq -r '.files.ignore[]?')

# The whole policy goes in a single `policy set`. Computing the difference is
# more code than --clear-ignore followed by --add-ignore, but those two cancel
# each other out in one invocation, and splitting them across two leaves a
# window where a failure in between drops every ignore rule and the next
# scheduled snapshot swallows the caches.
contains() {
    local needle=$1 item
    shift
    for item in "$@"; do
        [[ $item == "$needle" ]] && return 0
    done
    return 1
}

args=()
for rule in "${current[@]}"; do
    contains "$rule" "${wanted[@]}" || args+=(--remove-ignore "$rule")
done
for rule in "${wanted[@]}"; do
    contains "$rule" "${current[@]}" || args+=(--add-ignore "$rule")
done

kopia policy set --global \
    "${args[@]}" \
    --ignore-cache-dirs=true \
    --one-file-system=true \
    --compression=zstd \
    --keep-latest=3 \
    --keep-hourly=0 \
    --keep-daily=7 \
    --keep-weekly=4 \
    --keep-monthly=6 \
    --keep-annual=0

kopia policy show --global

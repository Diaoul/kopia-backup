[Unit]
Description=Activate kopia backup

[Timer]
# Fire often and let the service decide whether conditions are right.
OnCalendar=*-*-* 05,11,17,23:00:00
OnBootSec=10min
RandomizedDelaySec=10m

# Safe because the service enforces its own minimum interval.
Persistent=true

# The RTC alarm is armed before ConditionACPower is evaluated, so waking would
# happen on battery too, only to skip.
WakeSystem=false

[Install]
WantedBy=timers.target

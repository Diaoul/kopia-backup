[Unit]
Description=Activate kopia repository maintenance

[Timer]
OnCalendar=Tue 06:00:00
RandomizedDelaySec=30m

# Catch up if the machine was off, on battery or away on Tuesday. The service
# enforces its own minimum interval, so at most one maintenance run per week.
Persistent=true
WakeSystem=false

[Install]
WantedBy=timers.target

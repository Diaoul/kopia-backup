[Unit]
Description=Activate kopia repository full verification

[Timer]
# Daily on purpose: the service enforces the interval, so a day spent on
# battery or away from the repository only delays the run.
OnCalendar=*-*-* 07:00:00
RandomizedDelaySec=30m

Persistent=true
WakeSystem=false

[Install]
WantedBy=timers.target

[Unit]
Description=Kopia repository maintenance
Documentation=https://kopia.io/docs/advanced/maintenance/
Wants=network-online.target
After=network-online.target

# Full maintenance is heavy, so skip cleanly on battery.
ConditionACPower=true

[Service]
Type=oneshot
StateDirectory=kopia
LogsDirectory=kopia

# Type=oneshot disables the start timeout by default. The verification below
# downloads a fraction of the repository, which is unbounded work against a
# possibly stalled backend, so give it a ceiling.
TimeoutStartSec=6h

Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=batch

# Skip cleanly rather than fail when away from the repository. Five days keeps
# the catch-up run from maintaining twice in the same week, with enough slack
# that a run pushed late by RandomizedDelaySec does not make the next weekly
# trigger fall just short of the interval and skip a whole week.
ExecCondition=/usr/local/bin/kopia-condition maintenance 120

# Snapshots past the retention policy are already marked for deletion when a
# snapshot is created. Full maintenance is what actually reclaims their space.
ExecStart=kopia \
    --config-file /etc/kopia/repository.config \
    --log-dir /var/log/kopia \
    maintenance run --full
# A failed verification is a real problem, not a bad moment, so unlike the
# conditions above it is meant to fail the unit loudly. It also leaves the stamp
# below untouched, which makes the next run retry a week later.
ExecStartPost=kopia \
    --config-file /etc/kopia/repository.config \
    --log-dir /var/log/kopia \
    snapshot verify --verify-files-percent=1
ExecStartPost=touch %S/kopia/last-success-maintenance

# Global policy ignore rules, gitignore syntax.
#
# Patterns are matched against each snapshot source root, not against the
# filesystem root: a leading slash anchors to the source, so /cache excludes
# /var/cache in the /var snapshot. Patterns without a leading slash match at
# any depth.

# root directories
/cache
/lock
/log
/opt
/run
/spool
/tmp

# home directories
.cache
/.local/share/Trash
*/.local/share/Trash

#!/usr/bin/env bash
# ExecCondition helper for the kopia units.
#
# Usage: kopia-condition <timestamp-name> [min-interval-hours]
#
# Exit 0     run the unit
# Exit 1-254 skip the unit cleanly (no failure, no OnFailure, no alert)
# Exit 255   real failure, the unit is misconfigured
#
# Relies on StateDirectory=kopia.
set -uo pipefail

config=${KOPIA_CONFIG:-/etc/kopia/repository.config}
log_dir=${KOPIA_LOG_DIR:-/var/log/kopia}

if (( $# < 1 )); then
    echo "usage: kopia-condition <timestamp-name> [min-interval-hours]" >&2
    exit 255
fi

timestamp_name=$1
min_interval_hours=${2:-0}
timestamp=${STATE_DIRECTORY:-/var/lib/kopia}/last-success-${timestamp_name}

# Guards against catch-up runs from Persistent=true and against the timer
# running the unit more often than its interval.
if (( min_interval_hours > 0 )) && [[ -f $timestamp ]]; then
    # Default to 0 rather than let an unreadable timestamp turn into a syntax
    # error below: that would exit non-zero and skip the unit forever, looking
    # exactly like "ran recently".
    mtime=$(stat -c %Y "$timestamp" 2>/dev/null) || mtime=0
    age=$(( $(date +%s) - mtime ))
    # A timestamp dated in the future, from RTC skew before NTP settles or from
    # a restore, would otherwise be "too recent" until the clock catches up, and
    # skips are silent by design: the unit would quietly stop running for days.
    if (( age >= 0 && age < min_interval_hours * 3600 )); then
        echo "skip: last success $(( age / 3600 ))h ago, below ${min_interval_hours}h interval"
        exit 1
    fi
fi

# Opening the repository reads its format blob, so this checks the credentials
# and the repository too, not just that the host answers.
if ! timeout 90 kopia --config-file "$config" --log-dir "$log_dir" \
        repository status >/dev/null 2>&1; then
    echo "skip: repository unreachable"
    exit 2
fi
